# Telegram Bot Ayarları
# @BotFather üzerinden aldığınız bot token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Botun yalnızca size yanıt vermesi için Telegram User ID'niz
# (@userinfobot veya @getmyid_bot üzerinden öğrenebilirsiniz)
ALLOWED_TELEGRAM_USER_ID=123456789

# Takip edilecek varsayılan coinler (virgülle ayrılmış 40+ token)
WATCHLIST=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,DOGE/USDT,ADA/USDT,AVAX/USDT,SUI/USDT,LINK/USDT,NEAR/USDT,APT/USDT,DOT/USDT,PEPE/USDT,SHIB/USDT,UNI/USDT,FET/USDT,RENDER/USDT,AAVE/USDT,TAO/USDT,WIF/USDT,ICP/USDT,INJ/USDT,TIA/USDT,SEI/USDT,OP/USDT,ARB/USDT,BONK/USDT,POL/USDT,PENDLE/USDT,FLOKI/USDT,GALA/USDT,FTM/USDT,STX/USDT,ATOM/USDT,LDO/USDT,CRV/USDT,JUP/USDT,ONDO/USDT,ENA/USDT,KAS/USDT,WLD/USDT,MKR/USDT,RUNE/USDT

# Dinamik En Çok İşlem Gören Tokenleri Tarama (true/false)
DYNAMIC_TOP_TOKENS=true
TOP_TOKENS_LIMIT=40

# Otomatik Tarama Aralığı (Dakika cinsinden)
SCAN_INTERVAL_MINUTES=15

# Spam Önleme & Soğuma Süresi (Saat cinsinden - Aynı sinyal için tekrar uyarı gitmez)
ALERT_COOLDOWN_HOURS=6.0

# Ani Çakılış & Yükseliş Öncesi Erken Uyarılar (true/false)
EARLY_WARNING_ENABLED=true
VOLUME_SPIKE_MULTIPLIER=2.5
BOLLINGER_SQUEEZE_THRESHOLD=0.045

# RSI Eşik Seviyeleri
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Toplam Portföy Sermayesi (Varsayılan: 11000 USDT)
PORTFOLIO_CAPITAL_USDT=11000

# İşlem Başına Maksimum Risk Yüzdesi (Örn: %1.5)
DEFAULT_RISK_PERCENT=1.5

